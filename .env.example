# Copy to .env.local. Local values come from `pnpm exec supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Exact public origin of the app; used for Origin checks on guest routes.
APP_ORIGIN=http://localhost:3000
# HMAC pepper for rejoin codes and passcode cookies (32+ random bytes).
GUEST_PEPPER=
# AES-256-GCM key for the reveal secret, base64 (openssl rand -base64 32). Production environment only.
REVEAL_KEY_V1=
REVEAL_KEY_VERSION=1
# Bearer secret for /api/cron/*.
CRON_SECRET=
# Base URL of encoded scene media (R2/CDN). Empty = committed drafts.
NEXT_PUBLIC_MEDIA_URL=
# Development only: lets staff use the back office without MFA. Ignored in production.
STAFF_MFA_OPTIONAL=
# Card payments through Paymob (off unless PAYMOB_ENABLED=1). Test with a sandbox delivery first.
PAYMOB_ENABLED=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
# Optional overrides
PAYMOB_API_BASE=
PAYMOB_CHECKOUT_BASE=
PAYMOB_ALLOW_TEST_MODE=
